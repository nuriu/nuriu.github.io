---
const currentYear = new Date().getFullYear();
---

<footer class="bg-black border-t border-white/5 pt-24 pb-12 overflow-hidden relative">
  <div class="liquid-blur w-[300px] h-[300px] bg-primary top-[-150px] left-1/2 -translate-x-1/2 opacity-10"></div>

  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12 mb-20">
      
      <!-- Column 1: Info -->
      <div class="md:col-span-1">
        <div class="flex items-center gap-2 mb-8 group">
          <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center font-bold text-black">
            N
          </div>
          <span class="font-display font-bold text-xl tracking-tighter">NURI U.</span>
        </div>
        <p class="text-white/50 text-sm leading-relaxed mb-8 max-w-[240px]">
          Building tools that feel as natural as ink on paper, refined for the modern age. Melding clean engineering with thoughtful design.
        </p>
        <div class="flex gap-4">
           <a href="https://github.com/nuriu" class="text-xs font-bold text-white/40 hover:text-white transition-colors uppercase tracking-widest">Github</a>
           <a href="https://linkedin.com/in/nuriuzunoglu" class="text-xs font-bold text-white/40 hover:text-white transition-colors uppercase tracking-widest">LinkedIn</a>
        </div>
      </div>

      <!-- Column 2: Directory -->
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-8">Directory</h4>
        <ul class="space-y-4">
          <li><a href="/numera" class="text-sm text-white/40 hover:text-white transition-colors">Numera</a></li>
          <li><a href="/notio" class="text-sm text-white/40 hover:text-white transition-colors">Notio</a></li>
          <li><a href="/blog" class="text-sm text-white/40 hover:text-white transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Column 3: Let's Collaborate -->
      <div class="md:col-span-2">
         <h4 class="text-xs font-bold text-white uppercase tracking-widest mb-8">Let's Collaborate</h4>
         <p class="text-white/40 text-sm mb-6 max-w-sm">
           Looking for fresh perspectives on your next project? Let's chat about building something remarkable.
         </p>
         <a href="mailto:hello@nuriu.dev" class="text-2xl md:text-4xl font-display font-bold hover:text-primary transition-colors block mb-4">
           hello@nuriu.dev
         </a>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/5 pt-12 flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-[10px] text-white/30 uppercase tracking-[0.2em]">
        © {currentYear} Nuri Uzunoğlu
      </p>
      
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></div>
          <span class="text-[10px] text-white/30 uppercase tracking-[0.2em]">Built with ❤️ in Ankara</span>
        </div>
      </div>
    </div>
  </div>
</footer>
