---
interface Props {
  product: any;
  reverse?: boolean;
}

const { product, reverse = false } = Astro.props;
const { data } = product;

const imageSrc = data.title.toLowerCase() === 'numera' 
  ? '/assets/numera-mockup.png' 
  : '/assets/notio-mockup.png';
---

<section class="py-24 overflow-hidden" id={data.title.toLowerCase()}>
  <div class="container mx-auto px-6">
    <div class={`grid md:grid-cols-2 gap-12 md:gap-24 items-center ${reverse ? 'md:flex-row-reverse' : ''}`}>
      
      <!-- Content Column -->
      <div class={`${reverse ? 'md:order-2' : ''}`} data-reveal>
        <div class="flex items-center gap-4 mb-6">
          <div class="h-[1px] w-12 bg-white/20"></div>
          <span class="text-xs uppercase tracking-widest text-white/40 font-bold">{data.label}</span>
        </div>
        
        <h2 class="text-5xl md:text-7xl font-bold mb-4">{data.title}</h2>
        <p class="text-primary text-xl md:text-2xl font-medium mb-8 italic">"{data.tagline}"</p>
        
        <p class="text-white/60 text-lg leading-relaxed mb-10">
          {data.description}
        </p>

        {data.tags && (
          <div class="flex flex-wrap gap-4 mb-10">
            {data.tags.map((tag: string) => (
              <div class="glass-card px-4 py-3 rounded-2xl flex items-center gap-3">
                 <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
                 <span class="text-sm font-medium">{tag}</span>
              </div>
            ))}
          </div>
        )}

        {data.features && (
          <div class="space-y-6 mb-10">
            {data.features.map((feature: any) => (
              <div class="glass-card p-6 rounded-2xl border-white/5 hover:border-primary/20 group transition-all">
                <div class="flex gap-4">
                  <div class="w-12 h-12 rounded-xl glass border-primary/20 flex items-center justify-center text-primary group-hover:scale-110 transition-transform relative overflow-hidden">
                    <div class="absolute inset-0 bg-primary/5"></div>
                     {feature.icon === 'clock' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
                     {feature.icon === 'brain' && <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3-4-3-4.5V4a2 2 0 0 1 4 0v1h1a2 2 0 0 1 2 2v1l1.24 1.24a2 2 0 0 0 2.82 2.82L22 13v1a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-1l-1.24-1.24a2 2 0 0 0-2.82-2.82L13 9V8a2 2 0 0 1-4 0v-1H8a2 2 0 0 1-2-2V4a2 2 0 0 1 4 0v1c0 .5-1 2.9-3 4.5S4 13 4 15a7 7 0 0 0 7 7z"/></svg>}
                  </div>
                  <div>
                    <h4 class="font-bold mb-1">{feature.title}</h4>
                    <p class="text-sm text-white/50">{feature.description}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        {data.quote && (
          <div class="glass p-8 rounded-3xl border-primary/10 mb-10 relative overflow-hidden">
             <div class="absolute -top-4 -left-4 text-primary/10 text-8xl font-serif">"</div>
             <p class="text-white/80 italic text-lg relative z-10">{data.quote}</p>
          </div>
        )}

        <a href={data.cta.href} class="btn-primary inline-flex items-center group">
          {data.cta.text}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform">
             <line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Image Column -->
      <div class={`relative ${reverse ? 'md:order-1' : ''}`} data-reveal style="animation-delay: 0.2s;">
        <div class="absolute inset-0 bg-primary/10 blur-[120px] rounded-full"></div>
        <div class="glass p-4 rounded-[4rem] border-white/10 relative z-10 transform scale-95 hover:scale-100 transition-transform duration-700">
           <img src={imageSrc} alt={data.title} class="rounded-[3rem] w-full h-auto shadow-2xl" />
        </div>
      </div>
      
    </div>
  </div>
</section>
