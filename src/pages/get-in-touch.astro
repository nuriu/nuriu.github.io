---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Nuri Uzunoğlu">
	<section class="min-h-screen flex items-center justify-center pt-24">
		<div class="text-center px-6">
			<h1 class="text-7xl md:text-9xl font-bold mb-8">Contact.</h1>
			<p class="text-white/40 text-xl max-w-lg mx-auto leading-relaxed">
				Let's collaborate on something remarkable.
			</p>
			<a href="mailto:hello@nuriu.dev" class="text-4xl md:text-6xl font-display font-bold hover:text-primary transition-colors block mt-12">
				hello@nuriu.dev
			</a>
			<a href="/" class="btn-primary inline-flex mt-12 px-10">Back to Start</a>
		</div>
	</section>
</BaseLayout>
