---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductSection from '../components/ProductSection.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const sortedProducts = products.sort((a, b) => b.data.order - a.data.order);
---

<BaseLayout title="Nuri Uzunoğlu — Crafting Sleek Digital Tools">
	<Hero />
	<div id="projects" class="space-y-0">
		{sortedProducts.map((product, index) => (
			<ProductSection 
				product={product} 
				reverse={index % 2 !== 0} 
			/>
		))}
	</div>
</BaseLayout>
